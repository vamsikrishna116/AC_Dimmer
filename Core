        1,
        0
    );

    HAL_NVIC_EnableIRQ(
        EXTI0_IRQn
    );
}


/* ========================= ERROR HANDLER ========================= */

void Error_Handler(void)
{
    __disable_irq();

    while (1)
    {
        HAL_GPIO_TogglePin(
            TRIAC_PORT,
            TRIAC_PIN
        );

        HAL_Delay(250);
    }
}
