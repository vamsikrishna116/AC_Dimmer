        TRIAC_PORT,
        &GPIO_InitStruct
    );


    /* Relay - PB8 */

    HAL_GPIO_WritePin(
        RELAY_PORT,
        RELAY_PIN,
        GPIO_PIN_RESET
    );

    GPIO_InitStruct.Pin =
        RELAY_PIN;

    GPIO_InitStruct.Mode =
        GPIO_MODE_OUTPUT_PP;

    GPIO_InitStruct.Speed =
        GPIO_SPEED_FREQ_LOW;

    HAL_GPIO_Init(
        RELAY_PORT,
        &GPIO_InitStruct
    );


    /* Enable switch - PB7 */

    GPIO_InitStruct.Pin =
        SWITCH_PIN;

    GPIO_InitStruct.Mode =
        GPIO_MODE_INPUT;

    GPIO_InitStruct.Pull =
        GPIO_PULLUP;

    HAL_GPIO_Init(
