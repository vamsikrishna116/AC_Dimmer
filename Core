    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_AFIO_CLK_ENABLE();


    /* TRIAC gate - PB9 */

    HAL_GPIO_WritePin(
        TRIAC_PORT,
        TRIAC_PIN,
        GPIO_PIN_RESET
    );

    GPIO_InitStruct.Pin =
        TRIAC_PIN;

    GPIO_InitStruct.Mode =
