#include "main.h"

TIM_HandleTypeDef htim2;

#define TRIAC_PIN       GPIO_PIN_9
#define TRIAC_PORT      GPIOB

#define RELAY_PIN       GPIO_PIN_8
#define RELAY_PORT      GPIOB

#define SWITCH_PIN      GPIO_PIN_7
#define SWITCH_PORT     GPIOB

#define ZERO_CROSS_PIN  GPIO_PIN_0

#define HALF_CYCLE_US       10000U
#define TRIAC_PULSE_US      150U
#define MIN_DELAY_US        100U
#define MAX_DELAY_US        9800U

volatile uint8_t brightness = 70;
volatile uint8_t dimmer_enabled = 1;

/* Function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);

static uint32_t Calculate_Delay(uint8_t level);
static void Trigger_Triac(uint32_t delay_us);


/* ========================= MAIN ========================= */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_TIM2_Init();

    HAL_GPIO_WritePin(TRIAC_PORT, TRIAC_PIN, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(RELAY_PORT, RELAY_PIN, GPIO_PIN_RESET);

    /* Turn ON relay */
    HAL_GPIO_WritePin(RELAY_PORT, RELAY_PIN, GPIO_PIN_SET);

    while (1)
    {
        /*
         * Enable switch
         * PB7 = LOW -> dimmer enabled
         * PB7 = HIGH -> dimmer disabled
         */
        if (HAL_GPIO_ReadPin(SWITCH_PORT, SWITCH_PIN) == GPIO_PIN_RESET)
        {
            dimmer_enabled = 1;
            HAL_GPIO_WritePin(RELAY_PORT, RELAY_PIN, GPIO_PIN_SET);
        }
        else
        {
            dimmer_enabled = 0;
            HAL_GPIO_WritePin(RELAY_PORT, RELAY_PIN, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(TRIAC_PORT, TRIAC_PIN, GPIO_PIN_RESET);
        }

        HAL_Delay(10);
    }
}


/* ========================= BRIGHTNESS ========================= */

static uint32_t Calculate_Delay(uint8_t level)
{
    uint32_t delay;

    if (level == 0)
        return HALF_CYCLE_US;

    if (level > 100)
        level = 100;

    /*
     * Higher brightness = smaller firing delay
     */
    delay = MAX_DELAY_US -
            ((uint32_t)(level - 1) *
            (MAX_DELAY_US - MIN_DELAY_US) / 99U);

    return delay;
}


/* ========================= TRIAC CONTROL ========================= */

static void Trigger_Triac(uint32_t delay_us)
{
    if (!dimmer_enabled || brightness == 0)
        return;

    if (delay_us < MIN_DELAY_US)
        delay_us = MIN_DELAY_US;

    if (delay_us > MAX_DELAY_US)
        return;

    __HAL_TIM_SET_COUNTER(&htim2, 0);

    /*
     * Channel 1:
     * Turn TRIAC ON after firing delay
     *
     * Channel 2:
     * Turn TRIAC OFF after gate pulse
     */
    __HAL_TIM_SET_COMPARE(
        &htim2,
        TIM_CHANNEL_1,
        delay_us
    );

    __HAL_TIM_SET_COMPARE(
        &htim2,
        TIM_CHANNEL_2,
        delay_us + TRIAC_PULSE_US
    );

    __HAL_TIM_CLEAR_FLAG(
        &htim2,
        TIM_FLAG_CC1 | TIM_FLAG_CC2
    );

    HAL_TIM_OC_Start_IT(&htim2, TIM_CHANNEL_1);
    HAL_TIM_OC_Start_IT(&htim2, TIM_CHANNEL_2);
}


/* ========================= ZERO CROSS ========================= */

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == ZERO_CROSS_PIN)
    {
        /*
         * Every zero crossing starts a new AC half-cycle.
         */
        if (dimmer_enabled && brightness > 0)
        {
            Trigger_Triac(
                Calculate_Delay(brightness)
            );
        }
        else
        {
            HAL_GPIO_WritePin(
                TRIAC_PORT,
                TRIAC_PIN,
                GPIO_PIN_RESET
            );
        }
    }
}


/* ========================= TIMER CALLBACK ========================= */

void HAL_TIM_OC_DelayElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance != TIM2)
        return;

    /*
     * TRIAC firing
     */
    if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1)
    {
        if (dimmer_enabled && brightness > 0)
        {
            HAL_GPIO_WritePin(
                TRIAC_PORT,
                TRIAC_PIN,
                GPIO_PIN_SET
            );
        }

        HAL_TIM_OC_Stop_IT(
            &htim2,
            TIM_CHANNEL_1
        );
    }

    /*
     * End TRIAC gate pulse
     */
    else if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2)
    {
        HAL_GPIO_WritePin(
            TRIAC_PORT,
            TRIAC_PIN,
            GPIO_PIN_RESET
        );

        HAL_TIM_OC_Stop_IT(
            &htim2,
            TIM_CHANNEL_2
        );
    }
}


